# Порт и адрес HTTP/SSE-сервера (server/index.mjs)
PORT=4321
RADIOTV_HOST=127.0.0.1

# Каталог для базы SQLite (radiotv.sqlite) и подкаталога sets/ по умолчанию
RADIOTV_DATA_DIR=./server

# Каталоги с аудиосетами (разделитель ":" на Linux/macOS, ";" на Windows)
# Если не задано, используется <RADIOTV_DATA_DIR>/sets
RADIOTV_SETS_DIRS=./server/sets

# Каталог кеша очищенных от тегов аудиофайлов (в коде по умолчанию /var/cache/radiotv/audio)
RADIOTV_AUDIO_CACHE=./server/cache

# Секрет подписи токенов (не менее 32 символов). Если пусто, сервер читает или создаёт server/.secret
RADIOTV_SECRET=

# Список доверенных IP-адресов прокси через запятую для разбора X-Forwarded-For
RADIOTV_TRUSTED_PROXIES=

# Только для Vite dev-сервера: адрес API-прокси и включение read-only режима для /api/ (блокирует POST)
# RADIOTV_PREVIEW_API=http://127.0.0.1:4321

# Профиль pre-bake (AAC-LC 160-192k + faststart + loudnorm)
# RADIOTV_AUDIO_BITRATE=160k
# RADIOTV_FFMPEG_THREADS=1
# RADIOTV_PREBAKE_DELAY_MS=1500

# Продакшн-раздача аудио через Nginx secure_link (FI + PL Media Edge)
# RADIOTV_MEDIA_SIGN_SECRET=
# RADIOTV_MEDIA_URL_TTL_SEC=7200
# RADIOTV_MEDIA_PRIMARY_EDGE=fi
# RADIOTV_MEDIA_REDIRECT=1
# RADIOTV_MEDIA_EDGES=[{"id":"fi","region":"FI","baseUrl":"https://radio.tonivecher.online/media","healthUrl":"https://radio.tonivecher.online/media/health","priority":1,"local":true},{"id":"pl","region":"PL","baseUrl":"https://tonivecher.online/radio-media","healthUrl":"https://tonivecher.online/radio-media/health","priority":2,"manifestPath":"/var/cache/radiotv/edge-pl-manifest.json"}]
